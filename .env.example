# Copy to .env and fill in. Never commit .env.

# Comma-separated path entries (Isaac Lab + this repo's src/). Adjust to your machine.
PYTHONPATH=/path/to/isaac_irl/src:/path/to/IsaacLab/source/isaaclab:/path/to/IsaacLab/source/isaaclab_tasks:/path/to/IsaacLab/source/isaaclab_rl:/path/to/IsaacLab/source/isaaclab_assets

# https://wandb.ai/authorize
WANDB_API_KEY=your_wandb_api_key_here
